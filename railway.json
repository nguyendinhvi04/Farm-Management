{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "NIXPACKS",
        "buildCommand": "cd agri-backend/farm-backend && npm install"
    },
    "deploy": {
        "startCommand": "cd agri-backend/farm-backend && npm start",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
    }
}